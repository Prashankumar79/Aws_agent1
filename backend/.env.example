# ─────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────
APP_NAME=AWS Architecture AI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────
# Server / CORS
# ─────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000
# Comma-separated list. Use explicit hostnames in production. NEVER use "*"
# together with credentialed requests — it is rejected by browsers anyway.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────────────────
# Authentication (optional but RECOMMENDED for production)
# Leave empty in development. When set, every API request must include
#     X-API-Key: <value>
# A 32+ character random string is recommended:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# ─────────────────────────────────────────────────
API_KEY=

# ─────────────────────────────────────────────────
# AI Model Keys
# ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM_LIMIT=15
GEMINI_VISION_MODEL=gemini-2.5-pro
GEMINI_TEXT_MODEL=gemini-2.5-flash

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_BEDROCK_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS Textract is currently NOT used. OCR runs through Gemini Vision multimodal.
AWS_TEXTRACT_ENABLED=false

# ─────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_BASE_PATH=./data
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
OUTPUT_DIR=storage/outputs

# ─────────────────────────────────────────────────
# Image Processing
# ─────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=50
TILE_SIZE=1024
TILE_OVERLAP=128

# ─────────────────────────────────────────────────
# Confidence Thresholds
# ─────────────────────────────────────────────────
CONFIDENCE_THRESHOLD_LOW=0.65
CONFIDENCE_THRESHOLD_HIGH=0.85

# ─────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────
DATABASE_PATH=archlens.db

# ─────────────────────────────────────────────────
# RAG (Qdrant + BGE)
# ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
RAG_COLLECTION_NAME=infra_documents
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# LLM response cache
# L1 exact cache is safe for all tasks. L2 semantic cache is limited to the
# task list below so long-form architecture/design outputs do not cross-pollute.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_L1_MAX_SIZE=500
SEMANTIC_CACHE_L2_ENABLED=true
SEMANTIC_CACHE_L2_SCORE_THRESHOLD=0.94
SEMANTIC_CACHE_L2_TASK_TYPES=template_compression,image_compression,prompt_compression,prompt_suggestions,rag_synthesis,terraform_chat,prompt_analysis,component_extraction
SEMANTIC_CACHE_VERSION=v2

# ─────────────────────────────────────────────────
# LangChain
# ─────────────────────────────────────────────────
LANGCHAIN_VERBOSE=false

# ─────────────────────────────────────────────────
# Client Profile / Policy Engine
# ─────────────────────────────────────────────────
ENABLE_REPAIR_LOOP=true
MAX_REPAIR_ATTEMPTS=1
DEFAULT_CLIENT_PROFILE=default

# ─────────────────────────────────────────────────
# Job lifecycle
# ─────────────────────────────────────────────────
JOB_TTL_HOURS=168
PIPELINE_TIMEOUT_SECONDS=1800

# ─────────────────────────────────────────────────
# LangSmith Observability
# ─────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Aws_agent

# ─────────────────────────────────────────────────
# LLM Gateway / Cost Control
# ─────────────────────────────────────────────────
# Hard daily spend cap across ALL LLM calls (resets at midnight UTC).
# When exceeded, all calls are downgraded to Haiku (cheapest model).
DAILY_BUDGET_USD=5.00
